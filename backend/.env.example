# Set the production origin exactly in Railway; do not use wildcard origins.
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://portfolio2026.vercel.app
CORS_PREVIEW_ORIGIN_REGEX=^https://portfolio2026(?:-[a-z0-9-]+)?\.vercel\.app$

# Railway-only secret. Configure its value in Railway, never commit it.
OPENAI_API_KEY=<set-in-Railway-or-local-.env>
OPENAI_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Persist the Chroma collection outside the image. The service rebuilds only when this PDF changes.
PDF_RAG_PERSIST_DIRECTORY=/data/chroma
PDF_RAG_PDF_PATH=/app/backend/app/docs/CV_Lucas_Figueroa_1.pdf
# Interview contact delivery is disabled until all backend-only values are configured.
CONTACT_FORM_ENABLED=false
GMAIL_SMTP_EMAIL=your-address@gmail.com
GMAIL_SMTP_APP_PASSWORD=replace-with-google-app-password
CONTACT_HMAC_SECRET=replace-with-long-random-secret
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=600
CONTACT_IDEMPOTENCY_TTL_SECONDS=900
CONTACT_GUARD_CAPACITY=2000
